{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "subscription": {
      "type": "string"
    },
    "resourceGroup": {
      "type": "string"
    },
    "slackAlertsChannel": {
      "type": "string"
    },
    "slackAppToken": {
      "type": "securestring"
    },
    "teamsPowerAutomateWebhookUrl": {
      "type": "securestring"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "properties": {
            "data": {
              "properties": {
                "alertContext": {
                  "properties": {
                    "condition": {
                      "properties": {
                        "allOf": {
                          "properties": {
                            "metricName": {
                              "type": "string"
                            },
                            "timeAggregation": {
                              "type": "string"
                            },
                            "operator": {
                              "type": "string"
                            },
                            "threshold": {
                              "type": "string"
                            },
                            "metricValue": {
                              "type": "number"
                            },
                            "type": "object"
                          }
                        },
                        "windowStartTime": "string",
                        "windowEndTime": "string",
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "type": "object"
                },
                "essentials": {
                  "properties": {
                    "alertId": {
                      "type": "string"
                    },
                    "alertRule": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string"
                    },
                    "signalType": {
                      "type": "string"
                    },
                    "monitorCondition": {
                      "type": "string"
                    },
                    "monitoringService": {
                      "type": "string"
                    },
                    "alertTargetIDs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "originAlertId": {
                      "type": "string"
                    },
                    "firedDateTime": {
                      "type": "string"
                    },
                    "resolvedDateTime": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "essentialsVersion": {
                      "type": "string"
                    },
                    "alertContextVersion": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "schemaId": {
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    }
  },
  "actions": {
    "Capture raw variables": {
      "runAfter": {},
      "type": "Compose",
      "inputs": {
        "alertName": "@{triggerBody()?['data']?['essentials']?['alertRule']}",
        "severity": "@{triggerBody()?['data']?['essentials']?['severity']}",
        "operator": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['operator']}",
        "metricName": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['metricName']}",
        "timeAggregation": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['timeAggregation']}",
        "metricValue": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['metricValue']}",
        "threshold": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['threshold']}",
        "monitorCondition": "@{triggerBody()?['data']?['essentials']?['monitorCondition']}"
      }
    },
    "Compose message fragments": {
      "runAfter": {
        "Capture raw variables": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": {
        "outsideThresholdMessage": "The @{outputs('Capture raw variables')?['timeAggregation']} of @{outputs('Capture raw variables')?['metricName']} is at @{outputs('Capture raw variables')?['metricValue']}, which is @{outputs('Capture raw variables')?['operator']} the threshold of @{outputs('Capture raw variables')?['threshold']}",
        "withinThresholdMessage": "The @{outputs('Capture raw variables')?['timeAggregation']} of @{outputs('Capture raw variables')?['metricName']} is at @{if(empty(outputs('Capture raw variables')?['metricValue']), 'an acceptable value again', concat(outputs('Capture raw variables')?['metricValue'], ' and is no longer ', outputs('Capture raw variables')?['operator'], ' the ', outputs('Capture raw variables')?['threshold'], ' threshold'))}",
        "severityDisplay": "@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev0'), 'CRITICAL!', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev1'), 'Error!', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev2'), 'Warning', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev3'), 'Information', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev4'), 'Verbose', '')}",
        "severityColour": "@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev0'), 'danger', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev1'), 'danger', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev2'), 'warning', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev3'), 'good', '')}@{if(equals(outputs('Capture raw variables')?['severity'], 'Sev4'), 'good', '')}",
        "alertRuleUrl": "@{concat('https://portal.azure.com.mcas.ms/#@platform.education.gov.uk/resource', first(split(triggerBody()?['data']?['essentials']?['alertTargetIDs'][0], '/providers/')), '/providers/microsoft.insights/metricAlerts/', outputs('Capture raw variables')?['alertName'], '/overview')}",
        "alertTargetResourceUrl": "https://portal.azure.com/#@platform.education.gov.uk/resource@{triggerBody()?['data']?['essentials']?['alertTargetIDs'][0]}"
      }
    },
    "Compose message fields": {
      "runAfter": {
        "Compose message fragments": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": {
        "alertTime": "@{if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), formatDateTime(triggerBody()?['data']?['essentials']?['resolvedDateTime'], 'dd/MM/yyyy h:mm:sstt'), formatDateTime(triggerBody()?['data']?['essentials']?['firedDateTime'], 'dd/MM/yyyy h:mm:sstt'))}",
        "colour": "@{if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), 'good', outputs('Compose message fragments')?['severityColour'])}",
        "severity": "@{if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), 'Resolved', outputs('Compose message fragments')?['severityDisplay'])}",
        "windowStart": "@{if(equals(triggerBody()?['data']?['alertContext']?['condition']?['windowStartTime'], null), '', formatDateTime(triggerBody()?['data']?['alertContext']?['condition']?['windowStartTime'], 'dd/MM/yyyy h:mm:sstt'))}",
        "windowEnd": "@{if(equals(triggerBody()?['data']?['alertContext']?['condition']?['windowEndTime'], null), '', formatDateTime(triggerBody()?['data']?['alertContext']?['condition']?['windowEndTime'], 'dd/MM/yyyy h:mm:sstt'))}",
        "titleSlack": "*Alert @{outputs('Capture raw variables')?['monitorCondition']}!*\n@{outputs('Capture raw variables')?['alertName']}\n@{if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), '', concat(triggerBody()?['data']?['essentials']?['description'], '\n'))}\n@{if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), outputs('Compose message fragments')?['withinThresholdMessage'], outputs('Compose message fragments')?['outsideThresholdMessage'])}\n<@{outputs('Compose message fragments')?['alertRuleUrl']}|Link to alert>\n<@{outputs('Compose message fragments')?['alertTargetResourceUrl']}|Link to resource>",
        "titleTeams": "@{concat('Alert ', outputs('Capture raw variables')?['alertName'], ' ', toLower(outputs('Capture raw variables')?['monitorCondition']), if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), '', '!'))}",
        "alertLinkTeams": "@{if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), '', concat(triggerBody()?['data']?['essentials']?['description'], '\n'))}\n@{if(equals(outputs('Capture raw variables')?['monitorCondition'], 'Resolved'), outputs('Compose message fragments')?['withinThresholdMessage'], outputs('Compose message fragments')?['outsideThresholdMessage'])}\n[Link to alert](outputs('Compose message fragments')?['alertRuleUrl']})\n[Link to resource](@{outputs('Compose message fragments')?['alertTargetResourceUrl']})"
      }
    },
    "HTTP_Webhook": {
      "runAfter": {
        "Compose message fields": [
          "Succeeded"
        ]
      },
      "type": "HttpWebhook",
      "inputs": {
        "subscribe": {
          "method": "POST",
          "uri": "https://slack.com/api/chat.postMessage",
          "body": {
            "channel": "@parameters('slackAlertsChannel')",
            "text": "@outputs('Compose message fields')?['titleSlack']",
            "attachments": [
              {
                "color": "@outputs('Compose message fields')?['colour']",
                "fields": [
                  {
                    "title": "Alert",
                    "value": "@outputs('Compose message fields')?['alertName']",
                    "short": true
                  },
                  {
                    "title": "Severity",
                    "value": "@outputs('Compose message fields')?['severity']",
                    "short": true
                  },
                  {
                    "title": "@{outputs('Capture raw variables')?['monitorCondition']} at",
                    "value": "@outputs('Compose message fields')?['alertTime']",
                    "short": false
                  },
                  {
                    "title": "Window start",
                    "value": "@outputs('Compose message fields')?['windowStart']",
                    "short": true
                  },
                  {
                    "title": "Window end",
                    "value": "@outputs('Compose message fields')?['windowEnd']",
                    "short": true
                  }
                ]
              }
            ]
          },
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "@{concat('Bearer ', parameters('slackAppToken'))}"
          }
        },
        "unsubscribe": {}
      }
    },
    "HTTP_Teams": {
      "runAfter": {
        "Compose message fields": [
          "Succeeded"
        ]
      },
      "type": "Http",
      "inputs": {
        "uri": "@parameters('teamsPowerAutomateWebhookUrl')",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "type": "message",
          "attachments": [
            {
              "contentType": "application/vnd.microsoft.card.adaptive",
              "contentUrl": null,
              "content": {
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.2",
                "body": [
                  {
                    "type": "TextBlock",
                    "text": "@outputs('Compose message fields')?['titleTeams']",
                    "weight": "Bolder",
                    "size": "Medium",
                    "color": "@outputs('Compose message fields')?['colour']"
                  },
                  {
                    "type": "TextBlock",
                    "text": "@outputs('Compose message fields')?['alertLinkTeams']",
                    "wrap": true
                  },
                  {
                    "type": "FactSet",
                    "facts": [
                      {
                        "title": "Alert",
                        "value": "@outputs('Compose message fields')?['alertName']"
                      },
                      {
                        "title": "Severity",
                        "value": "@outputs('Compose message fields')?['severity']"
                      },
                      {
                        "title": "@{outputs('Capture raw variables')?['monitorCondition']} at",
                        "value": "@outputs('Compose message fields')?['alertTime']"
                      },
                      {
                        "title": "Window Start",
                        "value": "@outputs('Compose message fields')?['windowStart']"
                      },
                      {
                        "title": "Window End",
                        "value": "@outputs('Compose message fields')?['windowEnd']"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "runtimeConfiguration": {
        "contentTransfer": {
          "transferMode": "Chunked"
        }
      }
    }
  },
  "outputs": {}
}