{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "jsx": "preserve",
    "target": "es6",
    "types": ["node", "jest", "react", "react-dom", "react-syntax-highlighter"],
    "lib": ["dom", "esnext", "webworker"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@admin/*": ["./explore-education-statistics-admin/src/*"],
      "@common/*": ["./explore-education-statistics-common/src/*"],
      "@common-test/*": ["./explore-education-statistics-common/test/*"],
      "@frontend/*": ["./explore-education-statistics-frontend/src/*"],
    },
    "sourceMap": true,
  },
}
