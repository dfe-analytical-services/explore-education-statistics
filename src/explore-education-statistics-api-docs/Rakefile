require_relative './lib/notifier'
require 'chronic'

task default: ["notify:expired"]

namespace :notify do
  host_url = ENV.fetch("HOST_URL", "http://localhost:4567")

  pages_urls = [
    "#{host_url}/api/pages.json"
  ]

  limits = {
  }

  live = ENV.fetch("REALLY_POST_TO_TEAMS", "0") == "1"
  teams_webhook_url = ENV["TEAMS_WEBHOOK_URL"]

  if live && (teams_webhook_url.nil? || teams_webhook_url.empty?)
    fail "If you want to post to Teams you need to set TEAMS_WEBHOOK_URL"
  end

  desc "Notifies of all pages which have expired"
  task :expired do
    notification = Notification::Expired.new

    pages_urls.each do |page_url|
      puts "== #{page_url}"

      Notifier.new(notification, page_url, teams_webhook_url, live, limits.fetch(page_url, -1)).run
    end
  end

  desc "Notifies of all pages which will expire soon"
  task :expires, :timeframe do |_, args|
    args.with_defaults(timeframe: "in 1 month")
    expire_by = Chronic.parse(args[:timeframe]).to_date
    notification = Notification::WillExpireBy.new(expire_by)

    pages_urls.each do |page_url|
      puts "== #{page_url}"

      Notifier.new(notification, page_url, teams_webhook_url, live).run
    end
  end
end
