{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "rebaseWhen": "conflicted",
  "recreateWhen": "never",
  "azure-pipelines": {
    "enabled": false
  },
  "ignoreDeps": ["Mime-Detective"],
  "vulnerabilityAlerts": {
    "groupName": "renovate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": "0d",
    "rangeStrategy": "update-lockfile",
    "commitMessageSuffix": "[SECURITY]",
    "branchTopic": "{{{datasource}}}-{{{depName}}}-vulnerability",
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "matchCategories": ["python"],
      "enabled": false
    },
    {
      "matchDatasources": ["nuget", "dotnet-version"],
      "minimumReleaseAge": "3 days"
    },
    {
      "extends": ["schedule:earlyMondays"],
      "matchDatasources": ["nuget"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "rebaseWhen": "auto"
    },
    {
      "extends": ["schedule:monthly"],
      "matchDatasources": ["nuget"],
      "groupName": "Backend packages (minor)",
      "groupSlug": "minor-backend-packages",
      "matchUpdateTypes": ["minor"]
    },
    {
      "extends": ["schedule:quarterly"],
      "matchDatasources": ["nuget"],
      "groupName": "Backend packages",
      "groupSlug": "backend-packages",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Disable DuckDB.NET.Data.Full and InterpolatedSql.Dapper related to issue EES-6079",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["DuckDB.NET.Data.Full", "InterpolatedSql.Dapper"],
      "enabled": false
    },
    {
      "description": "Disable AutoMapper as v15 requires a license - EES-6647 to remove AutoMapper",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["AutoMapper"],
      "enabled": false
    },
    {
      "description": "Disable CliFx as v3 requires tinkering to update - EES-7179 to update or remove",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["CliFx"],
      "enabled": false
    },
    {
      "description": "Disable Generator.Equals as v4 requires change - EES-7194 to update",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["Generator.Equals"],
      "enabled": false
    },
    {
      "description": "Disable Microsoft.ApplicationInsights.* - EES-7198 to update",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "Microsoft.ApplicationInsights",
        "Microsoft.ApplicationInsights.AspNetCore",
        "Microsoft.ApplicationInsights.WorkerService"
      ],
      "enabled": false
    },
    {
      "description": "Disable packages which need their major versions to be in sync with the .NET version or the EF Core version",
      "matchDatasources": ["nuget"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "Microsoft.AspNetCore{/,}**",
        "Microsoft.EntityFrameworkCore{/,}**",
        "Microsoft.Extensions{/,}**",
        "Moq.EntityFrameworkCore{/,}**",
        "MockQueryable.EntityFrameworkCore{/,}**",
        "MockQueryable.Moq{/,}**",
        "Npgsql.EntityFrameworkCore.PostgreSQL{/,}**",
        "Thinktecture.EntityFrameworkCore{/,}**",
        "linq2db.EntityFrameworkCore{/,}**",
        "Asp.Versioning.Mvc{/,}**",
        "Asp.Versioning.Mvc.ApiExplorer{/,}**"
      ],
      "enabled": false
    },
    {
      "matchDatasources": ["pypi"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "enabled": false
    },
    {
      "matchDatasources": ["dotnet-version"],
      "matchDepNames": ["dotnet-sdk"],
      "allowedVersions": "<11.0.0",
      "automerge": true,
      "rebaseWhen": "auto"
    },
    {
      "matchDatasources": ["npm"],
      "enabled": false
    },
    {
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "matchDatasources": ["ruby-version"],
      "enabled": false
    },
    {
      "extends": ["schedule:monthly"],
      "matchDatasources": ["rubygems"],
      "groupName": "Ruby dependencies"
    },
    {
      "matchDatasources": ["azure-bicep-resource"],
      "enabled": false
    }
  ]
}
